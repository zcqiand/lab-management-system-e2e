# lab-management-system-e2e 运行时环境（进仓契约样例）
# 复制为 .env.local 填真值（.env.local 已 gitignore）。
# fail-fast：任一缺失即拒绝启动（禁默认值兜底，ADR-0019 精神）。

# 三前端 dev server 地址（外部起好，本仓不自起；起服约定见 docs/conventions/e2e-runtime.md）
# lab 家族端口段 5200（multi-repo-family.md §6）：X01=nextjs / X02=react / X03=vue
E2E_NEXTJS_URL=http://localhost:5201
E2E_REACT_URL=http://localhost:5202
E2E_VUE_URL=http://localhost:5203

# lab 后端 API base（API 登录 /auth/login 用——三前端无密码表单，见 tests/helpers.ts）
E2E_API_BASE_URL=http://localhost:5200/api

# 登录凭据（lab-msw users fixture + 家族 DEMO_PASSWORD；真值只进 .env.local，不进断言/注释）
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=
